# Supabase (Project Settings > API Keys). La publishable key (o la anon legacy)
# es pública por diseño: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# openrouter/free = router a modelos gratuitos. También acepta una lista separada por comas
# (fallback), p. ej. nex-agi/nex-n2.5-pro:free,openrouter/free
OPENROUTER_MODEL=openrouter/free
