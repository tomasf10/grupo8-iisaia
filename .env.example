# Supabase (Project Settings > API). La service role key es SOLO para el servidor.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Cualquier modelo gratuito (sufijo :free). Ver https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
